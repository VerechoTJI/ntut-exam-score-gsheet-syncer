# Google Sheets
SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
SHEET_TITLE=your-sheet-title

# Sync Interval in seconds (0 means one-time run)
INTERVAL=60

# Backend API Configuration
BACKEND_API_URL=http://localhost:3000
ADMIN_TOKEN=replace-with-the-backend-admin-token

# BACKOFF_MAX_SECONDS：後端 API 下次退避等待的上限（秒，預設 10，須大於 0）。
# 例：10 會依序等待 1、2、4、8 秒；下次要等 16 秒時就報錯停止。
# 不是整次操作的總時間，也不是同步間隔；不適用於 Google。
BACKOFF_MAX_SECONDS=10

# GOOGLE_TIMEOUT_SECONDS：Google 每次連線／讀取等待的 timeout（秒，預設 30，須大於 0）。
# 適用 Sheets、Drive 與 OAuth token 請求；認證重試交給 SDK 處理。
# 不限制使用者在瀏覽器完成登入的時間，也不是整次 Google 操作的總時間。
GOOGLE_TIMEOUT_SECONDS=30

# Optional independent database backup job (disabled while BACKUP_FOLDER is empty)
BACKUP_FOLDER=
BACKUP_INTERVAL=300
# Used in classroom_timestamp.sqlite; falls back to SHEET_TITLE if omitted
CLASSROOM=
